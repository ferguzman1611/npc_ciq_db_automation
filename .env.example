# ─── MongoDB ───────────────────────────────────────────────────────────────────
# Set to false to skip MongoDB writes entirely and only generate JSON files
MONGODB_ENABLED=

# Host and port of the MongoDB instance
MONGODB_HOST=
MONGODB_PORT=

# Database name. If not set, defaults to: database_<YYYYMMDD_HHMMSS>
MONGODB_DATABASE=

# Collection names (defaults shown below)
MONGO_COLLECTION_GLOBAL=
MONGO_COLLECTION_REGIONAL=
MONGO_COLLECTION_NETWORK=

# ─── Input ─────────────────────────────────────────────────────────────────────
# Name of the Excel file to read (must be placed inside the input/ folder)
INPUT_FILENAME=

# ─── Output ────────────────────────────────────────────────────────────────────
# Names of the (.json) output files (written to the output/ folder)
OUTPUT_FILENAME_GLOBAL=
OUTPUT_FILENAME_REGIONAL=
OUTPUT_FILENAME_NETWORK=